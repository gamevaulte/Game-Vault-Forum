rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'joelotis40@gmail.com' || 
         request.auth.token.admin == true);
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Validation for new user registration into the database
    // Enforces that all necessary fields during registration are present and correctly typed
    function isValidNewUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'username', 'role', 'createdAt']) &&
        data.uid is string && data.uid == userId && (data.uid == request.auth.uid || isAdmin()) &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.username is string && data.username.size() > 0 && data.username.size() <= 100 &&
        data.role is string && (data.role == 'user' || (data.role == 'admin' && isAdmin())) &&
        data.createdAt is string && data.createdAt.size() > 0;
    }

    // Validation for user profile updates
    function isValidUserUpdate(data, userId) {
      return isOwner(userId) || isAdmin();
    }

    // Connection health check endpoint for SDK testConnection()
    match /test/connection {
      allow read: if true;
    }

    // Users collection (primary collection per user request)
    match /Users/{userId} {
      // Anyone can read operative profiles for forum author attribution
      allow read: if true;
      // Enforce necessary fields during registration
      allow create: if isAuthenticated() && isValidId(userId) && isValidNewUser(incoming(), userId);
      // Allow user to update their own profile or admin
      allow update: if isAuthenticated() && isValidId(userId) && isValidUserUpdate(incoming(), userId);
      // Only admins or the user themselves can delete their account
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Secondary lowercase /users collection for backward compatibility
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(userId) && isValidNewUser(incoming(), userId);
      allow update: if isAuthenticated() && isValidId(userId) && isValidUserUpdate(incoming(), userId);
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Forum Topics collection
    match /topics/{topicId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.author.id == request.auth.uid);
    }

    // Article & Video Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Likes tracking
    match /likes/{likeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Newsletter Subscribers
    match /subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}

