rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'contact@gamevault.forum' || 
         request.auth.token.email == 'joelotis40@gmail.com' ||
         request.auth.token.admin == true);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Standalone Validation Blueprints
    function isValidContactSubmission(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 3000 &&
             data.status is string && data.status in ['new', 'read', 'replied', 'archived'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('id' in data) || (data.id is string && data.id.size() <= 150)) &&
             (!('subject' in data) || (data.subject is string && data.subject.size() <= 200)) &&
             (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128)) &&
             (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 150)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 50)) &&
             data.keys().hasAll(['id', 'name', 'email', 'category', 'message', 'createdAt', 'status']) &&
             data.keys().size() <= 12;
    }

    function isValidSubscriber(data) {
      return data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.subscribedAt is string && data.subscribedAt.size() <= 50 &&
             data.status is string && data.status in ['active', 'unsubscribed'] &&
             (!('id' in data) || (data.id is string && data.id.size() <= 150)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             data.keys().hasAll(['email', 'subscribedAt', 'status']) &&
             data.keys().size() <= 7;
    }

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check endpoint for SDK testConnection()
    match /test/connection {
      allow read: if true;
    }

    // Contact Us Submissions & Information Collections
    match /contact_submissions/{submissionId} {
      // PII Isolation: Only administrators or the authenticated submitter can read
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Validated submission from visitors or operatives
      allow create: if isValidId(submissionId) && isValidContactSubmission(incoming());
      // Only administrators can triage or remove inquiries
      allow update: if isAdmin() && isValidContactSubmission(incoming());
      allow delete: if isAdmin();
    }

    match /contact_us/{submissionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(submissionId) && isValidContactSubmission(incoming());
      allow update: if isAdmin() && isValidContactSubmission(incoming());
      allow delete: if isAdmin();
    }

    match /ContactUs/{submissionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(submissionId) && isValidContactSubmission(incoming());
      allow update: if isAdmin() && isValidContactSubmission(incoming());
      allow delete: if isAdmin();
    }

    match /Contact%20Us/{submissionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(submissionId) && isValidContactSubmission(incoming());
      allow update: if isAdmin() && isValidContactSubmission(incoming());
      allow delete: if isAdmin();
    }

    // Newsletter Subscribers Collections
    match /subscribers/{subscriberId} {
      // PII Isolation: Newsletter mailing list is only readable by administrators
      allow read: if isAdmin();
      // Visitors and members can subscribe
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      // Re-subscription or status update allowed safely
      allow update: if (isAdmin() && isValidSubscriber(incoming())) || 
                       (isValidSubscriber(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['subscribedAt', 'status', 'source']));
      allow delete: if isAdmin();
    }

    match /Subscriber/{subscriberId} {
      allow read: if isAdmin();
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      allow update: if (isAdmin() && isValidSubscriber(incoming())) || 
                       (isValidSubscriber(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['subscribedAt', 'status', 'source']));
      allow delete: if isAdmin();
    }

    match /Subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      allow update: if (isAdmin() && isValidSubscriber(incoming())) || 
                       (isValidSubscriber(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['subscribedAt', 'status', 'source']));
      allow delete: if isAdmin();
    }

    // Users collection (primary collection)
    match /Users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Secondary lowercase /users collection for backward compatibility
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Forum Topics collection
    match /topics/{topicId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.author.id == request.auth.uid);
    }

    // Article & Video Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Likes tracking
    match /likes/{likeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}


