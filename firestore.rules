rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'joelotis40@gmail.com' || 
         request.auth.token.admin == true);
    }

    // Users collection (primary collection per user request)
    match /Users/{userId} {
      // Anyone can read operative profiles for forum author attribution
      allow read: if true;
      // Allow authenticated users to create their own profile document
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Allow user to update their own profile or admin
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Only admins or the user themselves can delete their account
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Secondary lowercase /users collection for backward compatibility
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Forum Topics collection
    match /topics/{topicId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.author.id == request.auth.uid);
    }

    // Article & Video Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Likes tracking
    match /likes/{likeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Newsletter Subscribers
    match /subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
